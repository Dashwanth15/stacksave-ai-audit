{
  "schemaVersion": "2.0.0",
  "description": "Configurable strategy and recommendation weights for AIStackRecommendationEngine.",

  "compositeScore": {
    "_comment": "Default baseline weights if no strategy is specified.",
    "domainMatch":         0.25,
    "featureCoverage":     0.25,
    "capabilityScore":     0.20,
    "costEfficiency":      0.15,
    "enterpriseScore":     0.08,
    "vendorStability":     0.07
  },

  "strategies": {
    "balanced": {
      "domainMatch":         0.25,
      "featureCoverage":     0.25,
      "capabilityScore":     0.20,
      "costEfficiency":      0.15,
      "enterpriseScore":     0.08,
      "vendorStability":     0.07
    },
    "best-value": {
      "domainMatch":         0.20,
      "featureCoverage":     0.20,
      "capabilityScore":     0.10,
      "costEfficiency":      0.40,
      "enterpriseScore":     0.05,
      "vendorStability":     0.05
    },
    "max-performance": {
      "domainMatch":         0.30,
      "featureCoverage":     0.25,
      "capabilityScore":     0.30,
      "costEfficiency":      0.05,
      "enterpriseScore":     0.05,
      "vendorStability":     0.05
    },
    "enterprise-security": {
      "domainMatch":         0.15,
      "featureCoverage":     0.20,
      "capabilityScore":     0.15,
      "costEfficiency":      0.10,
      "enterpriseScore":     0.25,
      "vendorStability":     0.15
    }
  },

  "preferenceModifiers": {
    "_comment": "Score adjustments applied based on user preference toggles.",
    "avoidLockIn": {
      "penalty": -10,
      "applyWhen": "vendorLockInRisk_High"
    },
    "maximizeSavings": {
      "costEfficiencyBoost": 0.15,
      "capabilityReduction": -0.10
    },
    "preferOpenSource": {
      "bonus": 8,
      "applyWhen": "apiSupport_true"
    },
    "requireZeroRetention": {
      "penalty": -25,
      "applyWhen": "zeroDataRetention_false"
    },
    "preferEstablishedVendors": {
      "penalty": -10,
      "applyWhen": "vendorStabilityScore_lt50"
    }
  },

  "confidenceWeights": {
    "_comment": "Weights for 7-factor confidence score per recommendation. Must sum to 1.0.",
    "workflowMatch":         0.30,
    "featureCoverage":       0.25,
    "budgetFit":             0.15,
    "capabilitySuperiority": 0.10,
    "securityMatch":         0.10,
    "vendorStability":       0.05,
    "futureGrowth":          0.05
  },

  "stackGeneration": {
    "maxToolsPerStack":        4,
    "minCoverageThreshold":    0.80,
    "candidateSeedCount":      8,
    "complementarityMinScore": 60,
    "replacementMaxOverlap":   75
  },

  "optimizer": {
    "redundancyOverlapThreshold": 70,
    "maxVendorConcentrationHHI":  6000,
    "budgetOverrunTolerance":     0.10,
    "minCoverageForBudgetStack":  0.75,
    "minCoverageForPerfStack":    0.85
  },

  "knowledgeScoring": {
    "enterpriseComplianceWeight": 0.40,
    "enterpriseIdentityWeight":   0.30,
    "enterpriseAdminWeight":      0.30,
    "costTiers": {
      "free":    100,
      "lte10":    85,
      "lte20":    70,
      "lte40":    55,
      "lte80":    35,
      "above80":  20
    },
    "vendorStabilityWeights": {
      "reliabilityScore":       0.50,
      "enterpriseAvailability": 0.20,
      "sourcesPresent":         0.30
    },
    "benchmarkConfidenceThreshold": 70
  }
}
