# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stacksave?retryWrites=true&w=majority

# AI Service API Key (Grok)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Service Configuration (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional custom sender override (Default: StackSave AI Audit <notifications@stacksaveai.com>)
EMAIL_FROM=StackSave AI Audit <notifications@stacksaveai.com>

# Frontend URL for CORS and public URL generation
# Development: http://localhost:5173
# Production: https://stacksaveai.com
FRONTEND_URL=http://localhost:5173

# Server Port (Render will override this with PORT environment variable)
PORT=5000

# Environment
NODE_ENV=development

# ── Pricing Sync & Ingestion Admin Secret ─────────────────────────────────────
# Required for POST /api/admin/pricing/ingest and /api/admin/* endpoints.
# Generate a secure 64-character random hex string: openssl rand -hex 32
#
# THREE CONFIGURATION LOCATIONS REQUIRED:
#   1. Local Development: Set ADMIN_SECRET in backend/.env
#   2. Render Production: Set ADMIN_SECRET in Render Dashboard -> stacksave-backend -> Environment
#   3. GitHub Actions: Set ADMIN_SECRET in GitHub Repo -> Settings -> Secrets and variables -> Actions
#
# The GitHub Actions workflow also requires:
#   GitHub Repo -> Settings -> Secrets and variables -> Actions -> BACKEND_URL
#   Value: https://stacksave-backend.onrender.com
#
# DO NOT COMMIT YOUR REAL SECRET TO GIT.
ADMIN_SECRET=
